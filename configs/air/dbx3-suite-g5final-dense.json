{
  "name": "dbx3-suite-g5final-dense",
  "volume": "/Volumes/aistudio_dev_catalog/aios_segrlvr_dev/processed/conny",
  "timeout_minutes": 960,
  "sync_minutes": 10,
  "purpose": "Dense suite (192 tiles, cap 32) for FASRC G5 final (wpq 0.3/0.7).",
  "stage": {
    "data": {
      "path": "data",
      "manifests": [
        "trustmix_v2/train.jsonl",
        "trustmix_v2/validation_dense.jsonl"
      ]
    },
    "sam": "checkpoints/sam2.1_hiera_tiny.pt",
    "init": "adapters/s2-checkpoint-256",
    "eval_adapter": "adapters/g5-final"
  },
  "steps": [
    {
      "name": "dense192-cap32",
      "module": "nucleus_rl.grpo",
      "args": [
        "--objective",
        "grpo",
        "--eval-only",
        "--manifest",
        "{stage:data}/trustmix_v2/train.jsonl",
        "--model",
        "Qwen/Qwen3.6-27B",
        "--revision",
        "6a9e13bd6fc8f0983b9b99948120bc37f49c13e9",
        "--sam-checkpoint",
        "{stage:sam}",
        "--sam-config",
        "configs/sam2.1/sam2.1_hiera_t.yaml",
        "--coordinate-frame",
        "normalized1000",
        "--min-pixels",
        "200704",
        "--max-pixels",
        "200704",
        "--eval-sam-device",
        "cpu",
        "--seed",
        "42",
        "--eval-manifest",
        "{stage:data}/trustmix_v2/validation_dense.jsonl",
        "--max-objects",
        "32",
        "--eval-max-completion-length",
        "2048",
        "--max-sequence-length",
        "2048",
        "--init-adapter",
        "{stage:init}",
        "--output",
        "{output}",
        "--eval-adapter",
        "{stage:eval_adapter}"
      ]
    }
  ]
}