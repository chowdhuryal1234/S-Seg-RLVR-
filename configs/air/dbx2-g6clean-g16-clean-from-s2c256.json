{
  "name": "dbx2-g6clean-g16-clean-from-s2c256",
  "volume": "/Volumes/aistudio_dev_catalog/aios_segrlvr_dev/processed/conny",
  "module": "nucleus_rl.grpo",
  "timeout_minutes": 960,
  "sync_minutes": 10,
  "purpose": "G6 recipe with clean_v2 prompts (no MoNuSeg labels in the reward).",
  "stage": {
    "data": {
      "path": "data",
      "manifests": [
        "clean_v2/train.jsonl",
        "monuseg_official30_grpo_v1/validation.jsonl"
      ]
    },
    "sam": "checkpoints/sam2.1_hiera_tiny.pt",
    "init": "adapters/s2-checkpoint-256"
  },
  "args": [
    "--objective",
    "grpo",
    "--manifest",
    "{stage:data}/clean_v2/train.jsonl",
    "--eval-manifest",
    "{stage:data}/monuseg_official30_grpo_v1/validation.jsonl",
    "--output",
    "{output}",
    "--init-adapter",
    "{stage:init}",
    "--model",
    "Qwen/Qwen3.6-27B",
    "--revision",
    "6a9e13bd6fc8f0983b9b99948120bc37f49c13e9",
    "--sam-checkpoint",
    "{stage:sam}",
    "--sam-config",
    "configs/sam2.1/sam2.1_hiera_t.yaml",
    "--coordinate-frame",
    "normalized1000",
    "--min-pixels",
    "200704",
    "--max-pixels",
    "200704",
    "--eval-sam-device",
    "cpu",
    "--reward-sam-device",
    "cuda",
    "--augmentation",
    "d4",
    "--reward",
    "format=1,pq=1",
    "--group-size",
    "16",
    "--prompts-per-step",
    "1",
    "--temperature",
    "1.0",
    "--beta",
    "0.04",
    "--learning-rate",
    "2e-5",
    "--warmup-steps",
    "10",
    "--lora-rank",
    "16",
    "--lora-alpha",
    "32",
    "--max-steps",
    "300",
    "--eval-every",
    "150",
    "--save-steps",
    "100",
    "--max-completion-length",
    "512",
    "--eval-max-completion-length",
    "1024",
    "--max-sequence-length",
    "2048",
    "--max-objects",
    "8",
    "--seed",
    "42",
    "--wall-time-minutes",
    "720",
    "--backward-chunk",
    "8"
  ]
}