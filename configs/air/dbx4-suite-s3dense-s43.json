{
  "name": "dbx4-suite-s3dense-s43",
  "volume": "/Volumes/aistudio_dev_catalog/aios_segrlvr_dev/processed/conny",
  "timeout_minutes": 960,
  "sync_minutes": 10,
  "purpose": "Per-dataset suite (170 sparse cap 8 + 192 dense cap 32) for dbx3-s3dense-s43 final.",
  "stage": {
    "data": {
      "path": "data",
      "manifests": [
        "trustmix_v2/train.jsonl",
        "trustmix_v2/validation.jsonl",
        "trustmix_v2/validation_dense.jsonl"
      ]
    },
    "sam": "checkpoints/sam2.1_hiera_tiny.pt",
    "init": "runs/dbx3-s3dense-s43/adapter"
  },
  "steps": [
    {
      "name": "val170-cap8",
      "module": "nucleus_rl.grpo",
      "args": [
        "--objective",
        "grpo",
        "--eval-only",
        "--manifest",
        "{stage:data}/trustmix_v2/train.jsonl",
        "--model",
        "Qwen/Qwen3.6-27B",
        "--revision",
        "6a9e13bd6fc8f0983b9b99948120bc37f49c13e9",
        "--sam-checkpoint",
        "{stage:sam}",
        "--sam-config",
        "configs/sam2.1/sam2.1_hiera_t.yaml",
        "--coordinate-frame",
        "normalized1000",
        "--min-pixels",
        "200704",
        "--max-pixels",
        "200704",
        "--eval-sam-device",
        "cpu",
        "--seed",
        "42",
        "--eval-manifest",
        "{stage:data}/trustmix_v2/validation.jsonl",
        "--max-objects",
        "8",
        "--eval-max-completion-length",
        "1024",
        "--max-sequence-length",
        "2048",
        "--init-adapter",
        "{stage:init}",
        "--output",
        "{output}"
      ]
    },
    {
      "name": "dense192-cap32",
      "module": "nucleus_rl.grpo",
      "args": [
        "--objective",
        "grpo",
        "--eval-only",
        "--manifest",
        "{stage:data}/trustmix_v2/train.jsonl",
        "--model",
        "Qwen/Qwen3.6-27B",
        "--revision",
        "6a9e13bd6fc8f0983b9b99948120bc37f49c13e9",
        "--sam-checkpoint",
        "{stage:sam}",
        "--sam-config",
        "configs/sam2.1/sam2.1_hiera_t.yaml",
        "--coordinate-frame",
        "normalized1000",
        "--min-pixels",
        "200704",
        "--max-pixels",
        "200704",
        "--eval-sam-device",
        "cpu",
        "--seed",
        "42",
        "--eval-manifest",
        "{stage:data}/trustmix_v2/validation_dense.jsonl",
        "--max-objects",
        "32",
        "--eval-max-completion-length",
        "2048",
        "--max-sequence-length",
        "2048",
        "--init-adapter",
        "{stage:init}",
        "--output",
        "{output}"
      ]
    }
  ]
